    "personaScript": {
      "persona": "Elena Marsh",
      "personaRole": "Sustainability Director, Pelagia Foods International",
      "scenario": "Rehearsal: the traceability premium negotiation, three days before the real meeting.",
      "violetMoment": "Rehearsed Tuesday. Real meeting Friday. MarketEdge in the room for both.",
      "messages": [
        {
          "from": "client",
          "name": "SCPF negotiator",
          "text": "We are proposing a 12% premium on traceable crab, paid at the cooperative gate, not at the port."
        },
        {
          "from": "elena",
          "text": "Twelve percent is above what we pay anywhere in the region. Help me understand what I am buying for the extra margin."
        },
        {
          "from": "client",
          "text": "Verified chain of custody from 31 landing sites. Your two retail buyers announced traceable-sourcing commitments starting 2027. We are the only supply that gets you there on time."
        },
        {
          "from": "elena",
          "text": "Volumes. If I commit to the premium, can the federation guarantee 40 tonnes a month through the closed season?"
        },
        {
          "from": "client",
          "text": "Thirty-two tonnes guaranteed, with a path to 40 by month six as Kepu comes online. We would rather commit to a number we can hold."
        },
        {
          "from": "elena",
          "text": "That honesty helps you. Here is my condition: quarterly audits, shared, and the premium steps down if traceability coverage drops below 90%."
        },
        {
          "from": "client",
          "text": "Agreed on audits. On the step-down: make it symmetric. Coverage above 95% for two straight quarters moves the premium to 13%."
        },
        {
          "from": "elena",
          "text": "I can take symmetric step-ups to my board. Send the coverage methodology before Friday."
        }
      ],
      "coachNote": "What worked: leading with the buyer’s own 2027 commitments, conceding volume honestly, and converting her audit condition into a symmetric incentive. Practice the methodology answer next; she will ask how coverage is measured."
    }
  }
